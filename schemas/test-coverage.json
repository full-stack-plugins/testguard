{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Instance": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "string"
        },
        "obligation_id": {
          "type": "string"
        },
        "test_id": {
          "type": "string"
        }
      },
      "required": [
        "environment",
        "obligation_id",
        "test_id"
      ],
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "numerator": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "denominator",
        "numerator"
      ],
      "type": "object"
    },
    "SourceMetric": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "$ref": "#/definitions/Metric"
        },
        "filter": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "counts",
        "filter",
        "kind",
        "scope"
      ],
      "type": "object"
    }
  },
  "properties": {
    "execution": {
      "allOf": [
        {
          "$ref": "#/definitions/Metric"
        }
      ],
      "description": "Distinct required (test_id, environment) pairs: numerator counts passing completed executions; denominator counts unique required pairs."
    },
    "missing": {
      "description": "Missing obligation/test/environment edges. A missing shared execution retains an edge for every affected obligation.",
      "items": {
        "$ref": "#/definitions/Instance"
      },
      "type": "array"
    },
    "not_applicable_reasons": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "obligations": {
      "allOf": [
        {
          "$ref": "#/definitions/Metric"
        }
      ],
      "description": "Required obligations: numerator counts obligations whose every required edge is satisfied; denominator counts obligations."
    },
    "schema_version": {
      "const": "testguard.local/v1",
      "type": "string"
    },
    "source_metrics": {
      "items": {
        "$ref": "#/definitions/SourceMetric"
      },
      "type": "array"
    },
    "unsatisfied": {
      "description": "Unsatisfied obligation/test/environment edges, including missing, failed, skipped and unfinished executions.",
      "items": {
        "$ref": "#/definitions/Instance"
      },
      "type": "array"
    }
  },
  "required": [
    "execution",
    "missing",
    "not_applicable_reasons",
    "obligations",
    "schema_version",
    "source_metrics",
    "unsatisfied"
  ],
  "title": "CoverageEvidence",
  "type": "object"
}
